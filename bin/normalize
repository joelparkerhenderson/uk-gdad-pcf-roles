    x="lead-user-researcher" && test -e "$x" && mv "$x" "5-$x"
    x="head-of-user-research" && test -e "$x" && mv "$x" "6-$x"

    cd "$dir/user-centred-design/service-designer"
    rename 's/^service-designer-//' *
    x="associate-service-designer" && test -e "$x" && mv "$x" "1-$x"
    x="junior-service-designer" && test -e "$x" && mv "$x" "2-$x"
    x="service-designer" && test -e "$x" && mv "$x" "3-$x"
    x="senior-service-designer" && test -e "$x" && mv "$x" "4-$x"
    x="lead-service-designer" && test -e "$x" && mv "$x" "5-$x"
    x="head-of-service-design" && test -e "$x" && mv "$x" "6-$x"

done
